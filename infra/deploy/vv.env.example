# Configuração SEM segredo da produção. No servidor: /etc/vv/vv.env (root, 0640).
# Segredos NUNCA aqui: ficam um por arquivo em /etc/vv/segredos (infra/deploy/gerar-segredos.sh).

# Endereço público do sistema (o DNS A/AAAA precisa apontar para a VPS antes do 1º deploy: o Caddy pede o
# certificado ao Let's Encrypt na subida).
VV_DOMINIO=app.exemplo.com.br
VV_ENV=prod

# Imagens publicadas pelo workflow .github/workflows/imagens.yml (VV_VERSAO é definida pelo deploy.sh).
VV_REGISTRO=ghcr.io/dono-do-repositorio

# S3 dos documentos (ADR-017). ENDPOINT = o que a API/worker usam; PUBLIC_URL = a origem que o navegador
# acessa (entra na CSP). Bucket privado, região no Brasil (LGPD), versionamento ligado.
VV_S3_ENDPOINT=https://s3.provedor.exemplo
VV_S3_PUBLIC_URL=https://s3.provedor.exemplo
VV_S3_BUCKET=vv-docs-prod

# E-mail transacional (SMTP com STARTTLS; usuário e senha ficam em segredos).
VV_SMTP_HOST=smtp.provedor.exemplo
VV_SMTP_PORT=587
VV_EMAIL_REMETENTE=VV Licitações <nao-responda@exemplo.com.br>

# Web Push (opcional): chave PÚBLICA aqui; a privada vai em segredos (vapid_private_key).
VV_VAPID_PUBLIC_KEY=
VV_VAPID_CONTATO=mailto:ti@exemplo.com.br

# Contato que o robô de pesquisa informa aos portais no User-Agent (e-mail ou URL da empresa).
VV_ROBO_CONTATO=ti@exemplo.com.br

# Healthchecks.io (opcional): ping do worker e da pesquisa de editais (ausência = alarme por fora).
VV_HEALTHCHECK_URL=
VV_PESQUISA_HEARTBEAT_URL=

# Modelo da IA (só vale com chave cadastrada).
VV_LLM_MODELO=claude-sonnet-5-5
