{
  "name": "@vv/api",
  "private": true,
  "version": "0.0.0",
  "description": "API do VV Licitações (NestJS, ADR-011).",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "argon2": "^0.45.2",
    "cookie-parser": "^1.4.7",
    "kysely": "^0.29.8",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.23.1",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.3.2",
    "@swc/core": "^1.16.21",
    "@types/cookie-parser": "^1.4.10",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.14.0",
    "supertest": "^7.3.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
