# Copie para .env. Nunca commite valores reais.
VV_ENV=dev
# postgresql://vv_worker:<senha do .env da raiz>@127.0.0.1:5433/vv (no compose, o host é "postgres")
VV_DATABASE_URL=
VV_LOG_LEVEL=INFO
VV_HEALTHCHECK_URL=

# Web Push (ADR-018): chave PRIVADA VAPID (uv run python scripts/gerar_vapid.py); vazia = push desligado.
VV_VAPID_PRIVATE_KEY=
VV_VAPID_PUBLIC_KEY=
VV_VAPID_CONTATO=mailto:ti@vv.local
